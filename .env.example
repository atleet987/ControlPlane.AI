# ── Required ────────────────────────────────────────────────────────
# Upstash Redis connection string. Must use the rediss:// scheme —
# Upstash requires TLS and the client enables it from that scheme.
REDIS_URL=

# Google AI Studio key for the slow-path AI-as-judge verification detector.
# The judge layer is provider-agnostic; this is the currently bound provider.
GEMINI_API_KEY=

# ── Optional — every value below has a working default ──────────────
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=debug

# Local dev defaults to SQLite. Set to `mysql` (with the MYSQL_* vars) for
# production; the entities and schema are identical either way.
# DATABASE_DRIVER=sqlite
# SQLITE_PATH=./data/controlplane.sqlite
# DATABASE_SYNCHRONIZE=true
# DATABASE_LOGGING=false

# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=controlplane
# MYSQL_PASSWORD=
# MYSQL_DATABASE=controlplane

# REDIS_KEY_PREFIX=cpai:

# gemini-2.5-flash is closed to new API keys; 3.6-flash is the current default.
# GEMINI_MODEL=gemini-3.6-flash
# JUDGE_TIMEOUT_MS=20000

# DETECTION_FAST_PATH_TIMEOUT_MS=150
# DETECTION_SLOW_PATH_TIMEOUT_MS=25000
# DETECTION_SLOW_PATH_ENABLED=true
